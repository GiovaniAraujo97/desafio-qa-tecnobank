    {
      "name": "05 - Autenticar usuário",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Resposta contém token de autenticação', function () {",
              "  const responseText = pm.response.json();",
              "  pm.expect(responseText).to.include('Auth_token:');",
              "  const token = responseText.replace('Auth_token:', '').trim();",
              "  pm.expect(token).not.to.be.empty;",
              "  pm.environment.set('authToken', token);",
              "});",
              "pm.test('Tempo de resposta abaixo de 10 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(10000); });"
            ]
          }
        }
      ],
      "request": {

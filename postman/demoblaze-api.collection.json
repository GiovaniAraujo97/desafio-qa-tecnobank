{
  "info": {
    "_postman_id": "ea67926f-d477-44ab-b05b-0559301dd93c",
    "name": "Giovani Araujo - Demoblaze API",
    "description": "Fluxo de cadastro, autenticação e gerenciamento do carrinho de compras.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Criar conta",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('username', 'qa_' + Date.now() + '_' + Math.floor(Math.random() * 100000));",
              "const password = pm.environment.get('password');",
              "pm.environment.set('passwordEncoded', CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(password)));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Contrato de sucesso do cadastro', function () { pm.expect(pm.response.json()).to.eql(''); });",
              "pm.test('Tempo de resposta abaixo de 10 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(10000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{passwordEncoded}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{apiUrl}}/signup",
          "host": ["{{apiUrl}}"],
          "path": ["signup"]
        }
      }
    },

    {
      "name": "11 - Validar carrinho após remoção",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Contrato e conteúdo final do carrinho', function () {",
              "  const cart = pm.response.json();",
              "  pm.expect(cart).to.have.property('Items').that.is.an('array');",
              "  const ids = cart.Items.map(function (item) { return String(item.prod_id); });",
              "  pm.expect(ids).to.have.members([String(pm.environment.get('phoneId')), String(pm.environment.get('computerId'))]);",
              "  pm.expect(ids).not.to.include(String(pm.environment.get('monitorId')));",
              "});",
              "pm.test('Tempo de resposta abaixo de 10 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(10000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }

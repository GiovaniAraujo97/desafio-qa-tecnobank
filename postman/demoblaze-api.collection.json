    {
      "name": "09 - Consultar carrinho antes da remoção",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Contrato do carrinho é válido', function () {",
              "  const cart = pm.response.json();",
              "  pm.expect(cart).to.be.an('object');",
              "  pm.expect(cart).to.have.property('Items').that.is.an('array');",
              "  cart.Items.forEach(function (item) {",
              "    pm.expect(item).to.have.property('id');",
              "    pm.expect(item).to.have.property('prod_id');",
              "    pm.expect(item).to.have.property('cookie');",
              "  });",
              "  pm.expect(cart.Items).to.have.lengthOf(3);",
              "  const monitor = cart.Items.find(function (item) { return String(item.prod_id) === String(pm.environment.get('monitorId')); });",
              "  pm.expect(monitor, 'monitor presente antes da remoção').to.exist;",
              "  pm.environment.set('monitorCartItemId', monitor.id);",
              "});",
              "pm.test('Tempo de resposta abaixo de 10 segundos', function () { pm.expect(pm.response.responseTime).to.be.below(10000); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cookie\": \"{{authToken}}\",\n  \"flag\": true\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{apiUrl}}/viewcart",
          "host": ["{{apiUrl}}"],
          "path": ["viewcart"]
        }
      }
    },
